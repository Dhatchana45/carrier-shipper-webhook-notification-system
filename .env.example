# PostgreSQL
POSTGRES_DB=webhook_db
POSTGRES_USER=webhook_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Application database connection
DATABASE_URL=postgresql+psycopg://webhook_user:replace_with_a_strong_password@localhost:5433/webhook_db

# Authentication
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Webhook secret encryption
WEBHOOK_ENCRYPTION_KEY=replace_with_a_valid_fernet_key

# Local webhook testing
ALLOW_LOCAL_HTTP_WEBHOOKS=false

# Grafana SMTP (optional)
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=

# Django frontend
DJANGO_SECRET_KEY=replace_with_a_separate_long_random_secret
